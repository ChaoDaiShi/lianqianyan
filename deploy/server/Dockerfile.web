FROM nginxinc/nginx-unprivileged:1.27.5-alpine3.21@sha256:28d91bdce70ad09025ea901458fdd149259d8e05982ade79d4ef2c0d9470eb48

ARG SOURCE_COMMIT=unknown

LABEL org.opencontainers.image.title="lianqianyan-web" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}"

COPY --chown=101:101 deploy/server/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 dist /usr/share/nginx/html

USER 101:101

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/healthz"]
