# Copy this file to apps/api/.env. Never commit real credentials.

# Deployment-default OpenAI-compatible model.
EDUCATION_LLM_BASE_URL=https://your-provider.example.com/v1
EDUCATION_LLM_API_KEY=replace-with-your-llm-key
EDUCATION_LLM_MODEL=replace-with-your-model-id

# MiniMax international API: one key enables cloud TTS and image-01 generation.
EDUCATION_MINIMAX_API_KEY=replace-with-your-minimax-key
EDUCATION_MINIMAX_BASE_URL=https://api.minimax.io
EDUCATION_MINIMAX_MODEL=speech-02-hd
EDUCATION_MINIMAX_VOICE_ID=female-shaonv
EDUCATION_MINIMAX_IMAGE_MODEL=image-01

# Legacy regional MiniMax accounts only:
# EDUCATION_MINIMAX_BASE_URL=https://api.minimax.chat
# EDUCATION_MINIMAX_GROUP_ID=replace-with-your-uid

# AnySearch external learning search.
EDUCATION_ANYSEARCH_API_KEY=replace-with-your-anysearch-key
EDUCATION_ANYSEARCH_BASE_URL=https://api.anysearch.com
