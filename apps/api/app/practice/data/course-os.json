      "courseId": "course-os",
      "knowledgePointId": "kp-deadlock",
      "objectiveId": "deadlock-necessary-conditions",
      "stage": "practice",
      "prompt": "以下哪一项不是产生死锁的必要条件？",
      "options": [
        { "id": "a", "label": "互斥" },
        { "id": "b", "label": "请求并保持" },
        { "id": "c", "label": "可抢占" },
        { "id": "d", "label": "循环等待" }
      ],
      "correctOptionId": "c",
      "explanation": "死锁的四个必要条件是互斥、请求并保持、不可剥夺和循环等待；允许资源被抢占会破坏不可剥夺条件。",
      "difficulty": 0.6,
      "sourceRefs": ["course-os:deadlock.md#四个必要条件"],
      "misconceptionCode": "DEADLOCK_PREEMPTION_CONDITION"
    },
    {
